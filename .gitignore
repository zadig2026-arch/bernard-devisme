# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.gstack/

# scraped legacy assets — too large for git, regenerable via scripts/scrape.mjs
data/images/

# audio working files (WAV sources + MP3 renders) — large binaries, live in Sanity
data/audio-src/
data/audio-mp3/
data/audio-src-2026-06-12/
data/audio-mp3-2026-06-12/

# animation working files (GIFs from Sanity CDN + synced MP4 renders) — live in Sanity
data/gifs-live/
data/videos/

# firecrawl scratch
.firecrawl/

# session-specific preview state
.claude/launch.json
.claude/settings.local.json

